      "id": "bd524d5b-4b4e-438e-95d5-0e7417e1db54",
      "name": "Extract Reviews"
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json);\n\nconst reviews = rows\n  .filter(r => r.Review && String(r.Review).trim().length > 15)\n  .map((r, i) =>\n    `[${i + 1}] (${r.Date}, ${r.Rating}★, ${r.User}) ` +\n    String(r.Review).replace(/\\s+/g, ' ').trim()\n  )\n  .join('\\n');\n\nreturn [{ json: { reviews_text: reviews, review_count: rows.length } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        0
      ],
      "id": "dd8bb0a2-5c63-4288-8ea9-0dcdb6473a16",
      "name": "Prepare Reviews"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a product analyst. Analyze the customer reviews below.\n\nRules:\n1. Cluster the reviews into a MAXIMUM of 5 themes. For each theme give a name,\n   an approximate review count, and a one-line summary.\n2. Select the TOP 3 themes by frequency.\n3. Extract exactly 3 REAL user quotes. Copy them word for word from the reviews.\n   Never paraphrase or invent a quote.\n4. Identify ONE recurring confusion or pain point related to a fee or charge.\n   Give the fee name, a short summary of the confusion, and one verbatim quote.\n\nReturn only the JSON in the required format.\n\nREVIEWS:\n{{ $json.reviews_text }}",
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "message": "You are a precise analyst. Use only information present in the reviews"
            }
          ]
        },
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        896,
        0
      ],
      "id": "46f4b750-5f09-49dc-a93b-a6ba86534c93",
      "name": "Review Intelligence"
    },
    {
      "parameters": {
        "model": "qwen/qwen3.8-27b",
        "options": {}
      },
