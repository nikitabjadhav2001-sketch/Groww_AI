      ],
      "id": "473cdd16-e85c-42ad-97fe-e94a90825f0e",
      "name": "Structured Output Parser"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Write a weekly product pulse of MAXIMUM 250 words using ONLY this data:\n\n{{ JSON.stringify($json.output) }}\n\nUse exactly this structure:\n\n**Top Themes**\n- 3 bullets\n\n**Supporting User Quotes**\n- the 3 quotes, word for word\n\n**Key Observation**\n- 2-3 sentences on what is going wrong or trending\n\n**Action Ideas**\n1. ...\n2. ...\n3. ...\n\nDo not add information that is not in the data. Stay under 250 words.",
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        1216,
