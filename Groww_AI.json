}
    },
    {
      "parameters": {
        "jsonSchemaExample": "{\n  \"themes\": [\n    { \"name\": \"App performance\", \"count\": 12, \"summary\": \"Short summary\" }\n  ],\n  \"top_themes\": [\"Theme 1\", \"Theme 2\", \"Theme 3\"],\n  \"quotes\": [\"verbatim quote 1\", \"verbatim quote 2\", \"verbatim quote 3\"],\n  \"fee_issue\": {\n    \"fee_name\": \"Exit load\",\n    \"confusion_summary\": \"Short summary of the confusion\",\n    \"supporting_quote\": \"verbatim quote\"\n  }\n}"
      },
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
